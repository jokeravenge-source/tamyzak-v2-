{
  "name": "animation-studio",
  "version": "1.0.0",
  "description": "Deterministic procedural 3D short-film studio for Tamayzak reels",
  "repository": {
    "type": "git",
    "url": "https://github.com/jokeravenge-source/tamyzak-v2-.git",
    "directory": "animation-studio"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@remotion/bundler": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/media": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "@remotion/three": "4.0.539",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539",
    "three": "0.180.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/node": "22.19.0",
    "@types/react": "19.2.7",
    "@types/three": "0.180.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "scripts": {
    "audio": "node scripts/generate-audio.mjs",
    "predev": "npm run audio",
    "dev": "remotion studio --port=3100",
    "prebuild": "npm run audio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "render:opening": "npm run audio && node scripts/render.mjs opening",
    "render:reel": "npm run audio && node scripts/render.mjs reel",
    "render:preview": "npm run audio && node scripts/render.mjs preview",
    "storyboard": "npm run audio && node scripts/render.mjs storyboard"
  },
  "allowScripts": {
    "esbuild": false
  }
}
